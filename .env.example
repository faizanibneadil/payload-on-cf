# Payload CMS Secret (Required)
PAYLOAD_SECRET=your-32-byte-random-payload-secret

# Public Server URL (Optional / Default: http://localhost:3000)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare Configuration (Required for CI/CD deploy)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Code Playground
